{
  "name": "fintrack",
  "version": "1.0.0",
  "license": "MIT",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "build": "vite build",
    "dist": "vite build && electron-builder --mac",
    "dist:win": "vite build && electron-builder --win",
    "dist:linux": "vite build && electron-builder --linux"
  },
  "dependencies": {
    "chart.js": "^4.4.0",
    "dotenv": "^17.4.2",
    "motion": "^13.0.0",
    "plaid": "^45.0.0",
    "react": "^18",
    "react-chartjs-2": "^5",
    "react-dom": "^18"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4",
    "concurrently": "^8",
    "electron": "^28.3.3",
    "electron-builder": "^24",
    "vite": "^5",
    "wait-on": "^7"
  },
  "build": {
    "appId": "com.fintrack.app",
    "productName": "FinTrack",
    "mac": {
      "target": "dmg"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage",
      "category": "Office"
    },
    "files": [
      "dist/**",
      "electron/**"
    ]
  }
}
